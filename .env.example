# Copie para .env. Use somente dados e credenciais de teste.
# Neon: cole a connection string PostgreSQL fornecida pelo painel.
DATABASE_URL=

# IDs e credenciais do Confluent Cloud; nunca publique valores reais.
CONFLUENT_ENVIRONMENT_ID=
CONFLUENT_CLUSTER_ID=
CONFLUENT_BOOTSTRAP_SERVER=
CONFLUENT_PRODUCER_SERVICE_ACCOUNT_ID=
CONFLUENT_CONSUMER_SERVICE_ACCOUNT_ID=
CONFLUENT_API_KEY=
CONFLUENT_API_SECRET=
CONSUMER_KAFKA_API_KEY=
CONSUMER_KAFKA_API_SECRET=
SCHEMA_REGISTRY_URL=
SCHEMA_REGISTRY_CLUSTER_ID=
SCHEMA_REGISTRY_API_KEY=
SCHEMA_REGISTRY_API_SECRET=

# Banco usado pelo conector CDC. Crie um usuario dedicado cdc_user no Postgres.
CDC_DATABASE_HOST=
CDC_DATABASE_PORT=5432
CDC_DATABASE_NAME=payments
CDC_DATABASE_USER=cdc_user
CDC_DATABASE_PASSWORD=
CDC_PUBLICATION_NAME=payments_publication
CDC_SLOT_NAME=payments_slot
