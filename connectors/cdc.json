{
  "name": "payments-cdc",
  "connector.class": "PostgresCdcSourceV2",
  "tasks.max": "1",
  "kafka.auth.mode": "KAFKA_API_KEY",
  "kafka.api.key": "${CONFLUENT_API_KEY}",
  "kafka.api.secret": "${CONFLUENT_API_SECRET}",
  "database.hostname": "${CDC_DATABASE_HOST}",
  "database.port": "${CDC_DATABASE_PORT}",
  "database.user": "${CDC_DATABASE_USER}",
  "database.password": "${CDC_DATABASE_PASSWORD}",
  "database.dbname": "${CDC_DATABASE_NAME}",
  "plugin.name": "pgoutput",
  "publication.name": "${CDC_PUBLICATION_NAME}",
  "publication.autocreate.mode": "disabled",
  "slot.name": "${CDC_SLOT_NAME}",
  "topic.prefix": "payments",
  "table.include.list": "public.customers,public.accounts,public.cards,public.merchants,public.transactions",
  "output.data.format": "AVRO",
  "output.key.format": "AVRO",
  "heartbeat.interval.ms": "60000",
  "snapshot.mode": "initial",
  "database.sslmode": "require"
}
